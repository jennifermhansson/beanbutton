# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Database
POSTGRES_DB=beanbutton
POSTGRES_USER=beanbutton
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# Production only (used by docker-compose.prod.yml).
DOMAIN=your-domain.example.com
CERTBOT_EMAIL=you@example.com

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications (the app still works without them).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.com
