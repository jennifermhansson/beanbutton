# --- Stage 1: build the static frontend ---
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# --- Stage 2: serve static files + reverse proxy with Nginx ---
FROM nginx:1.27-alpine
# Remove the stock default site; our template generates the real one at startup.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# Files in /etc/nginx/templates/*.template are run through envsubst on startup,
# so ${DOMAIN} is substituted while runtime vars like $host are preserved.
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
